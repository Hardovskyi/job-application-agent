# LLM
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search (Tavily if set; otherwise DuckDuckGo)
TAVILY_API_KEY=

# LangSmith (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-application-agent

# Reviewer loop
MAX_REVISIONS=2
